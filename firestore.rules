rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Cada usuario solo puede leer y escribir su propio documento
    // y todo lo que hay dentro de él.
    match /usuarios/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /{subcoleccion=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Colecciones antiguas (datos de antes del login).
    // Cualquier usuario identificado puede LEERLAS para copiarlas a su cuenta
    // con el botón "Traer mis datos antiguos", pero ya nadie puede escribir.
    // Cuando hayas migrado, borra este bloque entero: la base queda cerrada.
    match /running/{doc}  { allow read: if request.auth != null; allow write: if false; }
    match /fuerza/{doc}   { allow read: if request.auth != null; allow write: if false; }
    match /semanas/{doc}  { allow read: if request.auth != null; allow write: if false; }
  }
}
